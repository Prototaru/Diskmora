{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diskmora",
  "version": "0.1.0",
  "identifier": "com.prototaru.diskmora",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1530",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Diskmora",
        "width": 1100,
        "height": 760,
        "minWidth": 400,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
